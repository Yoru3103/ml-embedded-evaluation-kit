set(${use_case}_ML_FRAMEWORK "${ML_FRAMEWORK_EXECUTORCH}")
if (NOT ML_FRAMEWORK STREQUAL ML_FRAMEWORK_EXECUTORCH)
    set(${use_case}_supports_${ML_FRAMEWORK} OFF)
    return()
endif()
if (ETHOS_U_NPU_MEMORY_MODE STREQUAL "Shared_Sram")
    set(DEFAULT_MODEL_PATH "${MLEK_ROOT}/resources_downloaded/asr_zh/int8-state-shared/zipformer_small_ctc_zh_u85_1024_shared_int8_state.pte")
elseif (ETHOS_U_NPU_MEMORY_MODE STREQUAL "Dedicated_Sram")
    set(DEFAULT_MODEL_PATH "${MLEK_ROOT}/resources_downloaded/asr_zh/dedicated-768k/zipformer_small_ctc_zh_u85_1024_dedicated_768k.pte")
else()
    set(DEFAULT_MODEL_PATH "")
endif()
if (USE_CASE_BUILD STREQUAL "all" AND
    (NOT ETHOS_U_NPU_ID STREQUAL "U85" OR NOT ETHOS_U_NPU_CONFIG_ID STREQUAL "Z1024"
     OR NOT DEFAULT_MODEL_PATH OR NOT EXISTS "${DEFAULT_MODEL_PATH}"))
    set(${use_case}_supports_${ML_FRAMEWORK} OFF)
    return()
endif()
if (NOT ETHOS_U_NPU_ENABLED OR NOT ETHOS_U_NPU_ID STREQUAL "U85" OR
    NOT ETHOS_U_NPU_CONFIG_ID STREQUAL "Z1024")
    message(FATAL_ERROR "asr_zh requires an enabled U85-1024 NPU")
endif()
if (ETHOS_U_NPU_MEMORY_MODE STREQUAL "Dedicated_Sram")
    if (NOT ETHOS_U_NPU_CACHE_SIZE EQUAL 786432)
        message(FATAL_ERROR "asr_zh Dedicated_Sram requires a 786432-byte cache")
    endif()
    set(ASR_ZH_METHOD_POOL_IN_DRAM OFF)
elseif (ETHOS_U_NPU_MEMORY_MODE STREQUAL "Shared_Sram")
    if (NOT ETHOS_U_NPU_CACHE_SIZE EQUAL 0)
        message(FATAL_ERROR "asr_zh Shared_Sram requires ETHOS_U_NPU_CACHE_SIZE=0")
    endif()
    set(ASR_ZH_METHOD_POOL_IN_DRAM ON)
else()
    message(FATAL_ERROR "asr_zh supports Dedicated_Sram or Shared_Sram")
endif()
set(${use_case}_supports_${ML_FRAMEWORK} ON)
list(APPEND ${use_case}_API_LIST asr_zh)
USER_OPTION(${use_case}_MODEL_PATH "Pinned streaming Zipformer COP1 PTE."
    ${DEFAULT_MODEL_PATH} FILEPATH)
USER_OPTION(${use_case}_ACTIVATION_BUF_SZ "DRAM method pool including inputs/planned memory."
    0x00800000 STRING)
USER_OPTION(${use_case}_FIXED_FEATURES "Use the first three PT2 reference feature chunks." OFF BOOL)
USER_OPTION(${use_case}_INT8_STATE "Use the matched INT8 cache interface." OFF BOOL)
USER_OPTION(${use_case}_VALIDATE "Print PT2 path/state sample comparisons for demo.wav." ON BOOL)
USER_OPTION(${use_case}_DUMP_TENSORS "Write the first three output sets using semihosting." OFF BOOL)
if (${${use_case}_DUMP_TENSORS} AND NOT SEMIHOSTING_ENABLED)
    message(FATAL_ERROR "asr_zh tensor dumping requires semihosting")
endif()
set_input_file_path_user_option(".wav" ${use_case})
generate_audio_code(${${use_case}_FILE_PATH} ${SAMPLES_GEN_DIR} 16000 ON 0 0 kaiser_best 0)
generate_model_code(MODEL_PATH ${${use_case}_MODEL_PATH}
    DESTINATION ${SRC_GEN_DIR} NAMESPACE "arm" "app" "asr_zh")
if (COMMAND generate_pte_ops_lib)
    generate_pte_ops_lib(MODEL_PATH "${${use_case}_MODEL_PATH}"
        LIB_NAME "${use_case}_portable_ops_lib" SELECT_OPS_LIST "")
    if (TARGET ${use_case}_portable_ops_lib)
        list(APPEND ${use_case}_LINK_LIBS ${use_case}_portable_ops_lib)
    endif()
endif()
add_library(asr_zh_options INTERFACE)
target_include_directories(asr_zh_options INTERFACE ${MLEK_ROOT}/resources/asr_zh)
if (${${use_case}_INT8_STATE})
    get_filename_component(STATE_METADATA_DIR "${${use_case}_MODEL_PATH}" DIRECTORY)
    if (NOT EXISTS "${STATE_METADATA_DIR}/StateQuantization.hpp")
        message(FATAL_ERROR "INT8 state model requires matching StateQuantization.hpp")
    endif()
    target_include_directories(asr_zh_options INTERFACE "${STATE_METADATA_DIR}")
endif()
target_compile_definitions(asr_zh_options INTERFACE
    ASR_ZH_METHOD_POOL_IN_DRAM=$<BOOL:${ASR_ZH_METHOD_POOL_IN_DRAM}>
    ASR_ZH_FIXED_FEATURES=$<BOOL:${${use_case}_FIXED_FEATURES}>
    ASR_ZH_INT8_STATE=$<BOOL:${${use_case}_INT8_STATE}>
    ASR_ZH_VALIDATE=$<BOOL:${${use_case}_VALIDATE}>
    ASR_ZH_DUMP_TENSORS=$<BOOL:${${use_case}_DUMP_TENSORS}>
    ASR_ZH_PROFILE=$<BOOL:${CPU_PROFILE_ENABLED}>)
if (CPU_PROFILE_ENABLED)
    if (NOT TARGET_PLATFORM STREQUAL "mps4")
        message(FATAL_ERROR "asr_zh stage profiling currently requires MPS4")
    endif()
    target_link_options(asr_zh_options INTERFACE "LINKER:--wrap=ethosu_invoke_v3")
endif()
list(APPEND ${use_case}_LINK_LIBS asr_zh_options)


USER_OPTION(${use_case}_INPUT_MODE "Chinese ASR audio input: STATIC, VSI or UART" STATIC STRING)
set_property(CACHE ${use_case}_INPUT_MODE PROPERTY STRINGS STATIC VSI UART)
if (${use_case}_INPUT_MODE STREQUAL "VSI")
    if (${${use_case}_FIXED_FEATURES} OR ${${use_case}_VALIDATE} OR ${${use_case}_DUMP_TENSORS})
        message(FATAL_ERROR "VSI demo requires fixed features, validation and tensor dumps OFF")
    endif()
    include(${MLEK_ROOT}/scripts/cmake/fvp_audio_demo.cmake)
    mlek_add_fvp_audio_demo(${use_case})
    target_compile_definitions(asr_zh_options INTERFACE ASR_ZH_INPUT_VSI)
elseif (${use_case}_INPUT_MODE STREQUAL "UART")
    if (SEMIHOSTING_ENABLED OR NOT TARGET_PLATFORM STREQUAL "mps4" OR NOT MPS4_DISPLAY_ENABLED)
        message(FATAL_ERROR "Chinese ASR UART demo requires MPS4, UART stdout and LCD")
    endif()
    target_compile_definitions(asr_zh_options INTERFACE ASR_ZH_INPUT_UART)
elseif (NOT ${use_case}_INPUT_MODE STREQUAL "STATIC")
    message(FATAL_ERROR "asr_zh_INPUT_MODE must be STATIC, VSI or UART")
endif()
