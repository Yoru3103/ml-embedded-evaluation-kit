#include "TokenEncoder.hpp"
asm(".section tinystories_tokenizer,\"a\",%progbits\n"
    ".balign 16\n"
    ".global tinystories_encoder_start\n"
    "tinystories_encoder_start:\n"
    ".incbin \"@TINYSTORIES_ENCODER_INC_PATH@\"\n"
    ".global tinystories_encoder_end\n"
    "tinystories_encoder_end:\n");
namespace arm::app::tinystories {
extern "C" const uint8_t tinystories_encoder_start[];
extern "C" const uint8_t tinystories_encoder_end[];
const uint8_t* GetEncoderData() { return tinystories_encoder_start; }
size_t GetEncoderSize()
{ return static_cast<size_t>(tinystories_encoder_end - tinystories_encoder_start); }
} // namespace arm::app::tinystories
