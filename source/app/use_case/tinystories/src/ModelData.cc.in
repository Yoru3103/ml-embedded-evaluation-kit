#include <cstddef>
#include <cstdint>

asm(
    ".section nn_model,\"a\",%progbits\n"
    ".balign 16\n"
    ".global tinystories_model_data_start\n"
    "tinystories_model_data_start:\n"
    ".incbin \"@TINYSTORIES_MODEL_INC_PATH@\"\n"
    ".global tinystories_model_data_end\n"
    "tinystories_model_data_end:\n");

namespace arm::app::tinystories {
extern "C" const uint8_t tinystories_model_data_start[];
extern "C" const uint8_t tinystories_model_data_end[];

const uint8_t* GetModelPointer()
{
    return tinystories_model_data_start;
}

size_t GetModelLen()
{
    return static_cast<size_t>(tinystories_model_data_end - tinystories_model_data_start);
}
} // namespace arm::app::tinystories
